    <div id="cursor-pill"></div>
    <div id="lightbox" aria-hidden="true">
      <button id="lightbox-close" type="button" aria-label="Close">&times;</button>
      <button id="lightbox-prev" type="button" aria-label="Previous">&lsaquo;</button>
      <img id="lightbox-img" src="" alt="" />
      <button id="lightbox-next" type="button" aria-label="Next">&rsaquo;</button>
      <p id="lightbox-caption"></p>
    </div>

    <script>
      // Nav identity — hide while h1 is visible, show after scroll
      const navIdentity = document.querySelector('.nav-identity');
      const heroH1 = document.querySelector('h1');
      new IntersectionObserver(([entry]) => {
        navIdentity.classList.toggle('visible', !entry.isIntersecting);
      }, { threshold: 0 }).observe(heroH1);

      // Crossfade animation
      const imgs = Array.from(document.querySelectorAll('.screen-slot img'));
      let idx = 0;

      function next() {
        imgs[idx].style.opacity = '0';
        idx = (idx + 1) % imgs.length;
        imgs[idx].style.opacity = '1';
        setTimeout(next, 5000);
      }

      imgs[0].style.opacity = '1';
      setTimeout(next, 5000);

      // Cursor pill
      const pill = document.getElementById('cursor-pill');
      const wraps = document.querySelectorAll('.screen-wrap[data-label]');

      wraps.forEach(wrap => {
        wrap.addEventListener('mouseenter', () => {
          pill.textContent = wrap.dataset.label;
          pill.classList.add('visible');
        });
        wrap.addEventListener('mouseleave', () => {
          pill.classList.remove('visible');
        });
      });

      document.addEventListener('mousemove', e => {
        pill.style.left = e.clientX + 'px';
        pill.style.top = e.clientY + 'px';
      });

      // Mobile lightbox
      if (window.matchMedia('(hover: none)').matches) {
        const lightbox = document.getElementById('lightbox');
        const lightboxImg = document.getElementById('lightbox-img');
        const lightboxCaption = document.getElementById('lightbox-caption');
        let lightboxItems = [];
        let lightboxIdx = 0;
        let touchStartX = 0;
        let didSwipe = false;

        function getWrapImage(wrap) {
          const slot = wrap.querySelector('.screen-slot');
          if (slot) return Array.from(slot.querySelectorAll('img')).find(img => img.style.opacity === '1') || slot.querySelector('img');
          return wrap.querySelector('img');
        }

        function showAt(i) {
          lightboxIdx = (i + lightboxItems.length) % lightboxItems.length;
          const item = lightboxItems[lightboxIdx];
          lightboxImg.src = item.src;
          lightboxImg.alt = item.alt || '';
          lightboxCaption.textContent = item.caption;
        }

        function openLightbox(startIdx) {
          lightboxItems = Array.from(wraps).map(wrap => {
            const img = getWrapImage(wrap);
            return { src: img.src, alt: img.alt, caption: wrap.dataset.label };
          });
          showAt(startIdx);
          lightbox.classList.add('open');
          lightbox.setAttribute('aria-hidden', 'false');
          document.body.style.overflow = 'hidden';
        }

        function closeLightbox() {
          lightbox.classList.remove('open');
          lightbox.setAttribute('aria-hidden', 'true');
          document.body.style.overflow = '';
        }

        lightbox.addEventListener('touchstart', e => {
          touchStartX = e.touches[0].clientX;
          didSwipe = false;
        }, { passive: true });

        lightbox.addEventListener('touchmove', e => {
          if (Math.abs(e.touches[0].clientX - touchStartX) > 10) didSwipe = true;
        }, { passive: true });

        lightbox.addEventListener('touchend', e => {
          const dx = e.changedTouches[0].clientX - touchStartX;
          if (Math.abs(dx) > 50) showAt(lightboxIdx + (dx < 0 ? 1 : -1));
        }, { passive: true });

        lightbox.addEventListener('click', () => { if (!didSwipe) closeLightbox(); });

        wraps.forEach((wrap, i) => {
          wrap.addEventListener('click', () => openLightbox(i));
        });

        // Trawa hero lightbox
        const trawaHero = document.querySelector('.trawa-hero');
        if (trawaHero) {
          trawaHero.addEventListener('click', () => {
            lightboxItems = [{ src: trawaHero.src, alt: trawaHero.alt, caption: 'Trawa dashboard' }];
            showAt(0);
            lightbox.classList.add('open');
            lightbox.setAttribute('aria-hidden', 'false');
            document.body.style.overflow = 'hidden';
          });
        }

        // Premium carousel lightbox
        const premOriginals = Array.from(document.querySelectorAll('.prem-item[data-label]'));
        const premLbItems = premOriginals.map(el => {
          const img = el.querySelector('img');
          return { src: img.src, alt: img.alt, caption: el.dataset.label };
        });

        // Attach to all items (originals + duplicates) — duplicates map back via mod 5
        Array.from(document.querySelectorAll('.prem-item')).forEach((el, i) => {
          el.addEventListener('click', () => {
            lightboxItems = premLbItems;
            showAt(i % premLbItems.length);
            lightbox.classList.add('open');
            lightbox.setAttribute('aria-hidden', 'false');
            document.body.style.overflow = 'hidden';
          });
        });
      }

      // Selected Work — filters
      const filterBtns = document.querySelectorAll('.filter-btn');
      const pins = document.querySelectorAll('.pin');

      filterBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          filterBtns.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          const filter = btn.dataset.filter;
          pins.forEach(pin => {
            pin.classList.toggle('pin-hidden', filter !== 'all' && pin.dataset.category !== filter);
          });
        });
      });

      // Selected Work — lightbox (all devices)
      {
        const lightbox = document.getElementById('lightbox');
        const lightboxImg = document.getElementById('lightbox-img');
        const lightboxCaption = document.getElementById('lightbox-caption');
        const closeBtn = document.getElementById('lightbox-close');
        const prevBtn = document.getElementById('lightbox-prev');
        const nextBtn = document.getElementById('lightbox-next');
        let pinItems = [];
        let pinIdx = 0;
        let pinLightboxActive = false;

        function showPinAt(i) {
          pinIdx = (i + pinItems.length) % pinItems.length;
          const img = pinItems[pinIdx].querySelector('img');
          const caption = pinItems[pinIdx].querySelector('.pin-caption');
          lightboxImg.src = img.src;
          lightboxImg.alt = img.alt;
          lightboxCaption.textContent = caption ? caption.textContent : '';
        }

        function openPinLightbox(pin) {
          pinItems = Array.from(pins).filter(p => !p.classList.contains('pin-hidden'));
          pinIdx = pinItems.indexOf(pin);
          pinLightboxActive = true;
          showPinAt(pinIdx);
          lightbox.classList.add('open');
          lightbox.setAttribute('aria-hidden', 'false');
          document.body.style.overflow = 'hidden';
        }

        function closePinLightbox() {
          pinLightboxActive = false;
          lightbox.classList.remove('open');
          lightbox.setAttribute('aria-hidden', 'true');
          document.body.style.overflow = '';
        }

        pins.forEach(pin => {
          pin.addEventListener('click', () => openPinLightbox(pin));
        });

        closeBtn.addEventListener('click', e => { e.stopPropagation(); closePinLightbox(); });
        prevBtn.addEventListener('click', e => { e.stopPropagation(); showPinAt(pinIdx - 1); });
        nextBtn.addEventListener('click', e => { e.stopPropagation(); showPinAt(pinIdx + 1); });

        lightbox.addEventListener('click', e => {
          if (pinLightboxActive && e.target === lightbox) closePinLightbox();
        });

        document.addEventListener('keydown', e => {
          if (!pinLightboxActive) return;
          if (e.key === 'Escape') closePinLightbox();
          if (e.key === 'ArrowLeft') showPinAt(pinIdx - 1);
          if (e.key === 'ArrowRight') showPinAt(pinIdx + 1);
        });

        let pinTouchStartX = 0;
        let pinDidSwipe = false;

        lightbox.addEventListener('touchstart', e => {
          if (!pinLightboxActive) return;
          pinTouchStartX = e.touches[0].clientX;
          pinDidSwipe = false;
        }, { passive: true });

        lightbox.addEventListener('touchmove', e => {
          if (!pinLightboxActive) return;
          if (Math.abs(e.touches[0].clientX - pinTouchStartX) > 10) pinDidSwipe = true;
        }, { passive: true });

        lightbox.addEventListener('touchend', e => {
          if (!pinLightboxActive || !pinDidSwipe) return;
          const dx = e.changedTouches[0].clientX - pinTouchStartX;
          if (Math.abs(dx) > 50) showPinAt(pinIdx + (dx < 0 ? 1 : -1));
        }, { passive: true });
      }

      // Page fade-out on navigation
      document.querySelectorAll('a[href]').forEach(link => {
        const href = link.getAttribute('href');
        if (!href || href.startsWith('#') || href.startsWith('mailto:') || link.target === '_blank') return;
        link.addEventListener('click', e => {
          e.preventDefault();
          document.body.style.transition = 'opacity 0.2s ease';
          document.body.style.opacity = '0';
          setTimeout(() => { window.location.href = href; }, 210);
        });
      });
    </script>
  </body>

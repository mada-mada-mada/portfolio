---
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/icon_magda.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Magdalena Szymaniec — Senior Product Designer & Art Director based in Berlin." />
    <title>Magdalena Szymaniec</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Lora:wght@600&family=DM+Sans:wght@400;600&family=Gentium+Plus:wght@700&display=swap" rel="stylesheet" />
    <style>
      *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        scroll-behavior: smooth;
      }

      @keyframes page-fade-in {
        from { opacity: 0; }
        to   { opacity: 1; }
      }

      body {
        font-family: 'DM Sans', sans-serif;
        background-color: #f7f6fa;
        color: #302b36;
        min-height: 100vh;
        display: flex;
        justify-content: center;
        animation: page-fade-in 0.35s ease both;
      }

      /* ── Nav ── */
      nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 24px;
        background-color: #f7f6fa;
        position: sticky;
        top: 0;
        z-index: 50;
      }

      .nav-identity {
        display: none;
        align-items: center;
        gap: 10px;
        text-decoration: none;
        color: #302b36;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.3s ease;
      }

      .nav-identity.visible {
        opacity: 1;
        pointer-events: auto;
      }

      .nav-name {
        font-size: 0.875rem;
        font-weight: 600;
      }

      .nav-links {
        display: flex;
        align-items: center;
        gap: 4px;
      }

      .nav-link {
        font-size: 0.875rem;
        font-weight: 600;
        color: #827d87;
        text-decoration: none;
        padding: 5px 14px;
        border-radius: 999px;
        transition: color 0.2s ease, background-color 0.2s ease;
      }

      .nav-link:hover {
        color: #302b36;
      }

      .nav-link.active {
        background-color: #9b90cc;
        color: #ffffff;
      }

      .nav-link.active:hover {
        background-color: #8778bc;
      }

      a:not(.btn-cv):not(.btn-case-study):not(.nav-link):not(.nav-identity) {
        color: #302b36;
        text-decoration: underline;
        text-underline-offset: 3px;
        text-decoration-thickness: 1px;
        text-decoration-color: #c8c5d0;
        transition: color 0.15s ease, text-decoration-color 0.15s ease;
      }

      a:not(.btn-cv):not(.btn-case-study):not(.nav-link):not(.nav-identity):hover {
        color: #9b90cc;
        text-decoration-color: #9b90cc;
      }

      .page {
        width: 100%;
        display: flex;
        flex-direction: column;
        min-height: 100vh;
      }

      main {
        flex: 1;
        padding: 40px 24px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 16px;
      }

      .header {
        display: flex;
        align-items: center;
        gap: 12px;
      }

      .header img {
        width: 64px;
        height: 63px;
        flex-shrink: 0;
      }

      .header-text {
        display: flex;
        flex-direction: column;
        gap: 3px;
      }

      .name {
        font-family: 'Lora', serif;
        font-size: 1.25rem;
        font-weight: 600;
        color: #302b36;
        line-height: 1.2;
      }

      .job-title {
        font-size: 0.875rem;
        font-weight: 400;
        color: #827d87;
        line-height: 1.3;
      }

      h1 {
        font-family: 'Lora', serif;
        font-size: 1.75rem;
        font-weight: 600;
        color: #302b36;
        line-height: 1.35;
      }

      .intro {
        font-size: 0.9375rem;
        color: #302b36;
        line-height: 1.55;
      }

      .cta {
        padding: 8px 0;
      }

      .btn-cv {
        display: inline-block;
        background-color: #9b90cc;
        color: #ffffff;
        font-family: 'DM Sans', sans-serif;
        font-size: 0.9375rem;
        font-weight: 600;
        text-decoration: none;
        padding: 10px 20px;
        transition: background-color 0.15s ease;
      }

      .btn-cv:hover {
        background-color: #8778bc;
      }

      footer {
        background-color: #eae5fc;
        padding: 24px 24px 40px;
        display: flex;
        flex-direction: column;
        gap: 16px;
      }

      .links {
        display: flex;
        flex-direction: column;
        gap: 8px;
        list-style: none;
      }

      .links a {
        font-size: 0.9375rem;
        font-weight: 400;
      }

      .copyright {
        font-size: 0.8125rem;
        color: #827d87;
        line-height: 1.55;
      }

      .case-study {
        background-color: #f3f1fe;
        padding: 24px 24px 16px;
        display: flex;
        flex-direction: column;
        gap: 12px;
      }

      .cs-meta {
        display: flex;
        flex-direction: column;
        gap: 2px;
      }

      .cs-date {
        font-size: 0.8125rem;
        color: #827d87;
      }

      .cs-title {
        font-family: 'Gentium Plus', serif;
        font-size: 1.375rem;
        font-weight: 700;
        color: #302b36;
        line-height: 1.2;
      }

      .cs-description {
        font-size: 0.9375rem;
        color: #302b36;
        line-height: 1.55;
      }

      .cs-preview {
        background-color: #f7f6fa;
        width: 100%;
        padding: 24px;
        display: flex;
        flex-direction: row;
        gap: 12px;
        align-items: center;
        justify-content: center;
        overflow-x: auto;
        border: 1px solid #d8d2f0;
      }

      .cs-preview .cs-screen {
        height: 180px;
        width: auto;
        flex-shrink: 0;
        display: block;
        border-radius: 6px;

      }

      .screen-slot {
        display: grid;
        grid-template-rows: 180px;
        grid-template-columns: max-content;
        flex-shrink: 0;
        border-radius: 7px;
        background-color: #eae5fc;
        overflow: hidden;

      }

      .screen-slot img {
        grid-area: 1 / 1;
        height: 180px;
        width: auto;
        opacity: 0;
        transition: opacity 1.2s ease;
      }


      .screen-wrap {
        position: relative;
        flex-shrink: 0;
      }

      #cursor-pill {
        position: fixed;
        pointer-events: none;
        background-color: #302b36;
        color: #ffffff;
        font-family: 'DM Sans', sans-serif;
        font-size: 0.8125rem;
        font-weight: 600;
        padding: 6px 14px;
        border-radius: 999px;
        white-space: nowrap;
        opacity: 0;
        transition: opacity 0.15s ease;
        z-index: 100;
        transform: translate(14px, -50%);
      }

      #cursor-pill.visible {
        opacity: 1;
      }

      .cs-cta {
        padding: 4px 0 8px;
      }

      .btn-case-study {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background-color: #9b90cc;
        color: #ffffff;
        font-family: 'DM Sans', sans-serif;
        font-size: 0.9375rem;
        font-weight: 600;
        text-decoration: none;
        padding: 8px 16px;
        transition: background-color 0.15s ease;
      }

      .btn-case-study:hover {
        background-color: #8778bc;
      }

      .btn-case-study svg {
        flex-shrink: 0;
      }

      /* ── Trawa section ── */
      .case-study.trawa .cs-preview {
        display: block;
      }

      .trawa-hero {
        width: 100%;
        height: auto;
        display: block;
        border-radius: 6px;
      }

      /* ── Premium section ── */
      .case-study.premium {
        background-color: #f7f6fa;
      }
      .case-study.premium .cs-preview {
        background-color: #f3f1fe;
        border-color: #d8d2f0;
        overflow: hidden;
        display: block;
        padding: 24px 0;
      }

      .prem-reel {
        display: flex;
        width: max-content;
        align-items: center;
        will-change: transform;
        animation: scroll-prem 40s linear infinite;
      }

      .prem-reel:hover {
        animation-play-state: paused;
      }

      @keyframes scroll-prem {
        from { transform: translateX(0); }
        to   { transform: translateX(-50%); }
      }

      .prem-item {
        flex-shrink: 0;
        margin-right: 12px;
      }

      .prem-item img {
        height: 180px;
        width: auto;
        display: block;

      }

      /* ── Selected Work ── */
      .work-section {
        padding: 0 24px 8px;
        display: flex;
        flex-direction: column;
        gap: 20px;
      }

      .work-header {
        display: flex;
        flex-direction: column;
        gap: 12px;
      }

      .work-title {
        font-family: 'Lora', serif;
        font-size: 1.25rem;
        font-weight: 600;
        color: #302b36;
      }

      .work-filters {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
      }

      .filter-btn {
        font-family: 'DM Sans', sans-serif;
        font-size: 0.8125rem;
        font-weight: 600;
        color: #827d87;
        background: none;
        border: 1px solid #d8d2f0;
        border-radius: 999px;
        padding: 6px 14px;
        cursor: pointer;
        transition: color 0.2s ease, background-color 0.2s ease, border-color 0.2s ease;
      }

      .filter-btn:hover {
        color: #302b36;
      }

      .filter-btn.active {
        background-color: #9b90cc;
        border-color: #9b90cc;
        color: #ffffff;
      }

      .pin-grid {
        column-count: 2;
        column-gap: 12px;
      }

      .pin {
        position: relative;
        break-inside: avoid;
        margin-bottom: 12px;
        overflow: hidden;
        background-color: #f3f1fe;
        border: 1px solid #d8d2f0;
        cursor: pointer;
      }

      .pin.pin-hidden {
        display: none;
      }

      .pin img {
        display: block;
        width: 100%;
        height: auto;
      }

      .pin-overlay {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: flex-end;
        padding: 14px;
        background: linear-gradient(to top, rgba(48, 43, 54, 0.95), rgba(48, 43, 54, 0.35) 65%, rgba(48, 43, 54, 0.35));
        opacity: 0;
        transition: opacity 0.2s ease;
      }

      .pin:hover .pin-overlay {
        opacity: 1;
      }

      .pin-caption {
        color: #ffffff;
        font-family: 'DM Sans', sans-serif;
        font-size: 0.8125rem;
        font-weight: 600;
        line-height: 1.4;
      }

      @media (hover: none) {
        .pin-overlay {
          display: none;
        }
      }

      @media (min-width: 640px) {
        nav {
          padding: 16px clamp(48px, 8vw, 160px);
        }

        .nav-identity {
          display: flex;
        }

        .nav-identity img {
          width: 34px;
          height: 34px;
        }

        main {
          padding: 80px clamp(48px, 8vw, 160px);
          gap: 24px;
        }

        h1 {
          font-size: 3rem;
          max-width: 22ch;
          line-height: 1.15;
        }

        .name {
          font-size: 1.5rem;
        }

        .job-title {
          font-size: 1rem;
        }

        .intro {
          font-size: 1rem;
          max-width: 52ch;
        }

        footer {
          padding: 40px clamp(48px, 8vw, 160px) 56px;
        }

        .links {
          flex-direction: row;
          gap: 32px;
        }

        .case-study {
          padding: 40px clamp(48px, 8vw, 160px);
          gap: 20px;
        }

        .cs-title {
          font-size: 1.75rem;
        }

        .cs-description {
          font-size: 1rem;
          max-width: 60ch;
        }

        .cs-preview {
          gap: 48px;
          padding: 48px 40px;
        }

        .cs-preview .cs-screen {
          height: 420px;
        }

        .screen-slot {
          grid-template-rows: 420px;
          border-radius: 16px;
        }


        .screen-slot img {
          height: 420px;
        }

        .trawa-hero {
          border-radius: 16px;
        }

        .case-study.premium .cs-preview {
          padding: 48px 0;
        }

        .prem-item {
          margin-right: 20px;
        }

        .prem-item img {
          height: 300px;
        }

        .work-section {
          padding: 0 clamp(48px, 8vw, 160px) 16px;
          gap: 28px;
        }

        .work-header {
          flex-direction: row;
          align-items: center;
          justify-content: space-between;
        }

        .work-title {
          font-size: 1.5rem;
        }

        .pin-grid {
          column-count: 4;
          column-gap: 20px;
        }

        .pin {
          margin-bottom: 20px;
        }
      }

      @media (hover: none) {
        #cursor-pill { display: none; }
        .screen-wrap[data-label] { cursor: pointer; }
        .prem-item { cursor: pointer; }
      }

      #lightbox {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.88);
        z-index: 200;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 20px;
        padding: 32px 24px;
      }

      #lightbox.open { display: flex; }

      #lightbox img {
        max-width: 100%;
        max-height: 72vh;
        object-fit: contain;
        border-radius: 16px;
      }

      #lightbox-caption {
        color: #ffffff;
        font-family: 'DM Sans', sans-serif;
        font-size: 0.9375rem;
        font-weight: 600;
        text-align: center;
      }

      #lightbox-close,
      #lightbox-prev,
      #lightbox-next {
        position: fixed;
        background: none;
        border: none;
        color: #ffffff;
        cursor: pointer;
        line-height: 1;
        padding: 8px;
      }

      #lightbox-close {
        top: 16px;
        right: 16px;
        font-size: 2rem;
      }

      #lightbox-prev,
      #lightbox-next {
        top: 50%;
        transform: translateY(-50%);
        font-size: 3rem;
      }

      #lightbox-prev {
        left: 8px;
      }

      #lightbox-next {
        right: 8px;
      }

      @media (min-width: 640px) {
        #lightbox-prev {
          left: 24px;
        }

        #lightbox-next {
          right: 24px;
        }
      }
    </style>
  </head>
  <body>
    <div class="page">
      <nav>
        <a href="/" class="nav-identity">
          <img src="/icon_magda.svg" width="28" height="28" alt="" />
          <span class="nav-name">Magdalena Szymaniec</span>
        </a>
        <div class="nav-links">
          <a href="#" class="nav-link active">home</a>
          <a href="/about" class="nav-link">about</a>
        </div>
      </nav>
      <main>
        <div class="header">
          <img src="/icon_magda.svg" alt="" width="49" height="48" />
          <div class="header-text">
            <p class="name">Magdalena Szymaniec</p>
            <p class="job-title">Senior Product Designer · Art Direction</p>
          </div>
        </div>

        <h1>Hi, Magdalena here! I'm a creative human based in Berlin, Germany.</h1>

        <p class="intro">
          Welcome to my portfolio. Feel free to reach out at <a href="mailto:magda.szymaniec@gmail.com">magda.szymaniec@gmail.com</a>
        </p>

        <div class="cta">
          <a href="/CV_magdalena.pdf" class="btn-cv" target="_blank" rel="noopener noreferrer">Download My CV</a>
        </div>
      </main>

      <section class="work-section">
        <div class="work-header">
          <h2 class="work-title">Selected Work</h2>
          <div class="work-filters">
            <button class="filter-btn active" data-filter="all" type="button">All</button>
            <button class="filter-btn" data-filter="ux" type="button">UX + Strategy</button>
            <button class="filter-btn" data-filter="illustration" type="button">Illustration</button>
            <button class="filter-btn" data-filter="graphic" type="button">Graphic Design</button>
          </div>
        </div>

        <div class="pin-grid">
          <div class="pin" data-category="ux">
            <img src="/work/ux-strategy/ux-allergien.png" alt="BARFER'S BARF calculator — allergy question step" loading="lazy" />
            <div class="pin-overlay"><p class="pin-caption">I designed the BARFER'S dog and cat food calculator to help clients pick the most optimal food for their animals based on age, gender, weight, allergies, etc.</p></div>
          </div>
          <div class="pin" data-category="ux">
            <img src="/work/ux-strategy/ux-barf-rechner.png" alt="BARFER'S BARF calculator — results screen" loading="lazy" />
            <div class="pin-overlay"><p class="pin-caption">The results of the BARF calculator help the owners make informed decisions about their animals' nutrition.</p></div>
          </div>
          <div class="pin" data-category="ux">
            <img src="/work/ux-strategy/ux-questions-bm.png" alt="Blindmate — redesigned profile questions feature" loading="lazy" />
            <div class="pin-overlay"><p class="pin-caption">At Blindmate, users create each other's profiles by answering different types of questions about each other. I redesigned this feature to make it more engaging for the users, resembling a physical card game.</p></div>
          </div>
          <div class="pin" data-category="illustration">
            <img src="/work/illustration/illustration-ai-bm.png" alt="Blindmate — AI-generated illustration pipeline for question cards" loading="lazy" />
            <div class="pin-overlay"><p class="pin-caption">For the Blindmate questions redesign project, I created an AI pipeline to produce a consistent UI illustration style for over 300 questions in a little less than a week.</p></div>
          </div>
          <div class="pin" data-category="ux">
            <img src="/work/ux-strategy/ux-deutschebank-ideation.png" alt="Deutsche Bank — Palais Populaire augmented reality concept proposal" loading="lazy" />
            <div class="pin-overlay"><p class="pin-caption">Created a concept proposal for Deutsche Bank's project at Palais Populaire with Augmented Reality.</p></div>
          </div>
          <div class="pin" data-category="ux">
            <img src="/work/ux-strategy/ux-mytoys-retail.png" alt="and dos Santos — myToys retail digitalization project" loading="lazy" />
            <div class="pin-overlay"><p class="pin-caption">During my work at and dos Santos (Berlin-based innovation agency), I worked on projects aiming to activate offline users and bring them to the online platforms, for example through the company's catalog.</p></div>
          </div>
          <div class="pin" data-category="ux">
            <img src="/work/ux-strategy/ux-house-type1.svg" alt="Homeday — tablet tool for realtors" loading="lazy" />
            <div class="pin-overlay"><p class="pin-caption">At Homeday, I created a tablet-based tool for realtors to help them evaluate the property's value face-to-face with clients.</p></div>
          </div>
          <div class="pin" data-category="ux">
            <img src="/work/ux-strategy/ux-chatgpt-mock.png" alt="Trawa — green energy procurement visualization" loading="lazy" />
            <div class="pin-overlay"><p class="pin-caption">At Trawa, I had the pleasure of visualizing our client's energy procurement and highlighting their savings and use of green electricity.</p></div>
          </div>
          <div class="pin" data-category="ux">
            <img src="/work/ux-strategy/ux-portrait.jpg" alt="Leading a UX workshop for Wohnvoll in Frankfurt am Main" loading="lazy" />
            <div class="pin-overlay"><p class="pin-caption">Leading a UX workshop for Wohnvoll in Frankfurt am Main.</p></div>
          </div>

          <div class="pin" data-category="illustration">
            <img src="/work/illustration/illustration-book-cover.png" alt="Book cover for Harry Gallon's 'Every Fox Is a Rabid Fox', Dead Ink Books" loading="lazy" />
            <div class="pin-overlay"><p class="pin-caption">I created a cover design (typography and illustration) for Harry Gallon's debut novel "Every Fox Is a Rabid Fox", published by Dead Ink Books.</p></div>
          </div>
          <div class="pin" data-category="illustration">
            <img src="/work/illustration/illustration-bowie.jpg" alt="David Bowie mixed-media portrait" loading="lazy" />
            <div class="pin-overlay"><p class="pin-caption">Personal experimentation with traditional media and typography.</p></div>
          </div>
          <div class="pin" data-category="illustration">
            <img src="/work/illustration/illustration-sealed.png" alt="Book cover for Naomi Booth's 'Sealed', Dead Ink Books" loading="lazy" />
            <div class="pin-overlay"><p class="pin-caption">I created a cover design for Naomi Booth's horror novel "Sealed", published by Dead Ink Books.</p></div>
          </div>
          <div class="pin" data-category="illustration">
            <img src="/work/illustration/illustration-war-horse.jpg" alt="Illustration for Michael Morpurgo's 'War Horse', Folio Society" loading="lazy" />
            <div class="pin-overlay"><p class="pin-caption">An illustration for Michael Morpurgo's "War Horse", created for the Folio Society.</p></div>
          </div>
          <div class="pin" data-category="illustration">
            <img src="/work/illustration/illustration-a4-magazine-mockup.png" alt="Circus comic spread — Ringling College 'Meanwhile' graphic novel anthology" loading="lazy" />
            <div class="pin-overlay"><p class="pin-caption">Created a short comic for Ringling College of Art and Design's "Meanwhile" graphic novel anthology.</p></div>
          </div>
          <div class="pin" data-category="illustration">
            <img src="/work/illustration/illustration-homeday.svg" alt="Homeday GmbH — icon and UI illustration set" loading="lazy" />
            <div class="pin-overlay"><p class="pin-caption">Created a large set of icons and UI illustrations for Homeday GmbH.</p></div>
          </div>

          <div class="pin" data-category="graphic">
            <img src="/work/graphic-design/graphic-design-mood-brochure.png" alt="Wohnvoll — brochure mockup" loading="lazy" />
            <div class="pin-overlay"><p class="pin-caption">Created marketing assets for the service living company, Wohnvoll.</p></div>
          </div>
          <div class="pin" data-category="graphic">
            <img src="/work/graphic-design/graphic-design-1.jpg" alt="Ziegert — Berlin real estate expose layout" loading="lazy" />
            <div class="pin-overlay"><p class="pin-caption">I designed and laid out exposés for Ziegert for two of their Berlin real estate projects.</p></div>
          </div>
          <div class="pin" data-category="graphic">
            <img src="/work/graphic-design/graphic-design-2.jpg" alt="Ziegert — Berlin real estate expose layout" loading="lazy" />
            <div class="pin-overlay"><p class="pin-caption">I designed and laid out exposés for Ziegert for two of their Berlin real estate projects.</p></div>
          </div>
          <div class="pin" data-category="graphic">
            <img src="/work/graphic-design/graphic-design-mockup.png" alt="Comedy Shorts — improv comedy group branding, poster mockup" loading="lazy" />
            <div class="pin-overlay"><p class="pin-caption">I redesigned the logo and created new branding for the Berlin-based improv comedy group.</p></div>
          </div>
          <div class="pin" data-category="graphic">
            <img src="/work/graphic-design/graphic-design-trawa-whitepaper.jpg" alt="Trawa — power procurement whitepaper" loading="lazy" />

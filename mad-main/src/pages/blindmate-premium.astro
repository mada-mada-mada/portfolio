    <div id="cursor-preview"><img src="" alt="" /></div>
    <span id="feature-img-cursor-label"></span>

    <div id="lightbox">
      <button id="lightbox-close" aria-label="Close">&#x2715;</button>
      <button id="lightbox-prev" aria-label="Previous image">&#8249;</button>
      <img id="lightbox-img" src="" alt="" />
      <p id="lightbox-caption"></p>
      <button id="lightbox-next" aria-label="Next image">&#8250;</button>
    </div>

    <div id="glossary-popup-overlay"></div>
    <div id="glossary-popup">
      <div class="popup-handle"></div>
      <p class="popup-label" id="glossary-popup-label"></p>
      <p class="popup-text" id="glossary-popup-text"></p>
    </div>

    <script>
      // Glossary terms — bottom sheet on mobile, tooltip on desktop (CSS hover)
      const glossaryPopup = document.getElementById('glossary-popup');
      const glossaryOverlay = document.getElementById('glossary-popup-overlay');
      const glossaryLabel = document.getElementById('glossary-popup-label');
      const glossaryText = document.getElementById('glossary-popup-text');
      if (glossaryPopup && glossaryOverlay) {
        document.querySelectorAll('.glossary-term').forEach(term => {
          term.addEventListener('click', e => {
            e.stopPropagation();
            glossaryLabel.textContent = term.dataset.term;
            glossaryText.textContent = term.dataset.def;
            glossaryPopup.classList.add('open');
            glossaryOverlay.classList.add('open');
          });
        });
        glossaryOverlay.addEventListener('click', () => {
          glossaryPopup.classList.remove('open');
          glossaryOverlay.classList.remove('open');
        });
      }

      // Lightbox
      const lightbox = document.getElementById('lightbox');
      const lightboxImg = document.getElementById('lightbox-img');
      const lightboxCaption = document.getElementById('lightbox-caption');
      const lightboxClose = document.getElementById('lightbox-close');
      const lightboxPrev = document.getElementById('lightbox-prev');
      const lightboxNext = document.getElementById('lightbox-next');
      let lbItems = [];
      let lbIdx = 0;

      function lbShowAt(i) {
        lbIdx = (i + lbItems.length) % lbItems.length;
        const item = lbItems[lbIdx];
        lightboxImg.src = item.src;
        lightboxImg.alt = item.alt;
        lightboxCaption.textContent = item.caption;
        const multi = lbItems.length > 1;
        lightboxPrev.style.display = multi ? '' : 'none';
        lightboxNext.style.display = multi ? '' : 'none';
      }

      function lbOpen(clickedImg) {
        const frame = clickedImg.closest('.img-frame');
        const imgs = frame
          ? Array.from(frame.querySelectorAll('.wide-img'))
          : [clickedImg];
        const captionEl = frame ? frame.querySelector('.img-caption') : null;
        const caption = captionEl ? captionEl.textContent.trim() : '';
        lbItems = imgs.map(img => ({ src: img.src, alt: img.alt, caption }));
        lbIdx = imgs.indexOf(clickedImg);
        lbShowAt(lbIdx);
        lightbox.classList.add('open');
      }

      function lbClose() { lightbox.classList.remove('open'); }

      document.querySelectorAll('.wide-img').forEach(img => {
        img.style.cursor = 'pointer';
        img.addEventListener('click', () => lbOpen(img));
      });

      lightboxClose.addEventListener('click', lbClose);
      lightboxPrev.addEventListener('click', e => { e.stopPropagation(); lbShowAt(lbIdx - 1); });
      lightboxNext.addEventListener('click', e => { e.stopPropagation(); lbShowAt(lbIdx + 1); });
      lightbox.addEventListener('click', e => { if (e.target === lightbox) lbClose(); });

      document.addEventListener('keydown', e => {
        if (!lightbox.classList.contains('open')) return;
        if (e.key === 'ArrowRight') lbShowAt(lbIdx + 1);
        else if (e.key === 'ArrowLeft') lbShowAt(lbIdx - 1);
        else if (e.key === 'Escape') lbClose();
      });

      let lbSwipeX = 0;
      lightbox.addEventListener('touchstart', e => { lbSwipeX = e.touches[0].clientX; }, { passive: true });
      lightbox.addEventListener('touchend', e => {
        const dx = e.changedTouches[0].clientX - lbSwipeX;
        if (Math.abs(dx) > 50) lbShowAt(lbIdx + (dx < 0 ? 1 : -1));
      });

      // Carousel
      const track = document.getElementById('carouselTrack');
      const dotsContainer = document.getElementById('carouselDots');
      if (track) {
        const slides = Array.from(track.children);
        const dots = Array.from(dotsContainer.children);
        let current = 0;

        // Hide dots if only one slide
        if (slides.length <= 1) dotsContainer.style.display = 'none';

        function goTo(i) {
          current = (i + slides.length) % slides.length;
          track.style.transform = `translateX(-${current * 100}%)`;
          dots.forEach((d, idx) => d.classList.toggle('active', idx === current));
        }

        dots.forEach((dot, i) => dot.addEventListener('click', () => goTo(i)));

        const prevBtn = document.getElementById('carouselPrev');
        const nextBtn = document.getElementById('carouselNext');
        if (prevBtn) prevBtn.addEventListener('click', () => goTo(current - 1));
        if (nextBtn) nextBtn.addEventListener('click', () => goTo(current + 1));

        // Keyboard navigation
        document.addEventListener('keydown', e => {
          if (lightbox.classList.contains('open')) return;
          if (e.key === 'ArrowRight') goTo(current + 1);
          else if (e.key === 'ArrowLeft') goTo(current - 1);
        });

        // Touch swipe (mobile)
        let startX = 0;
        track.addEventListener('touchstart', e => { startX = e.touches[0].clientX; }, { passive: true });
        track.addEventListener('touchend', e => {
          const dx = e.changedTouches[0].clientX - startX;
          if (Math.abs(dx) > 40) goTo(current + (dx < 0 ? 1 : -1));
        });

        // Mouse drag (desktop)
        let mouseStartX = 0;
        let isDragging = false;
        track.addEventListener('mousedown', e => {
          mouseStartX = e.clientX;
          isDragging = true;
          track.style.cursor = 'grabbing';
        });
        window.addEventListener('mouseup', e => {
          if (!isDragging) return;
          isDragging = false;
          track.style.cursor = 'grab';
          const dx = e.clientX - mouseStartX;
          if (Math.abs(dx) > 40) goTo(current + (dx < 0 ? 1 : -1));
        });
        track.style.cursor = 'grab';

        // Click image opens lightbox at that slide
        slides.forEach((slide, i) => {
          const img = slide.querySelector('img');
          if (img) img.addEventListener('click', () => {
            lbItems = slides.map(s => {
              const si = s.querySelector('img');
              const title = s.querySelector('.cs-slide-title');
              return { src: si.src, alt: si.alt, caption: title ? title.textContent.trim() : '' };
            });
            lbShowAt(i);
            lightbox.classList.add('open');
          });
        });
      }

      // Cursor-following feature preview
      const cursorPreview = document.getElementById('cursor-preview');
      const cursorPreviewImg = cursorPreview ? cursorPreview.querySelector('img') : null;
      const featureThumbs = Array.from(document.querySelectorAll('.feature-thumb'));
      const featureRows = Array.from(document.querySelectorAll('.feature-row'));

      if (cursorPreview && window.matchMedia('(hover: hover)').matches) {
        let activeThumb = null;
        let hidePreviewTimer;

        featureRows.forEach((row, i) => {
          const thumb = featureThumbs[i];
          const triggers = [row.querySelector('strong'), row.querySelector('.feature-eye')].filter(Boolean);

          triggers.forEach(el => {
            el.addEventListener('mouseenter', () => {
              clearTimeout(hidePreviewTimer);
              if (!thumb) return;
              activeThumb = thumb;
              cursorPreviewImg.src = thumb.src;
              cursorPreviewImg.alt = thumb.alt;
              cursorPreview.classList.add('visible');
            });
            el.addEventListener('mouseleave', () => {
              hidePreviewTimer = setTimeout(() => {
                cursorPreview.classList.remove('visible');
                activeThumb = null;
              }, 50);
            });
          });

          row.addEventListener('click', () => {
            lbItems = featureThumbs.map(t => ({ src: t.src, alt: t.alt, caption: t.dataset.title || '' }));
            lbShowAt(i);
            lightbox.classList.add('open');
          });
        });

        document.addEventListener('mousemove', e => {
          if (!cursorPreview.classList.contains('visible')) return;
          cursorPreview.style.left = (e.clientX + 20) + 'px';
          cursorPreview.style.top = (e.clientY - cursorPreview.offsetHeight / 2) + 'px';
        });

        // Cursor preview for conversion section placement rows
        const placementRows = Array.from(document.querySelectorAll('.placement-row'));
        placementRows.forEach((row, i) => {
          const src = row.dataset.previewSrc;
          const title = row.dataset.previewTitle || '';
          const triggers = [row.querySelector('strong'), row.querySelector('.feature-eye')].filter(Boolean);

          triggers.forEach(el => {
            el.addEventListener('mouseenter', () => {
              clearTimeout(hidePreviewTimer);
              if (!src) return;
              cursorPreviewImg.src = src;
              cursorPreviewImg.alt = title;
              cursorPreview.classList.add('visible');
            });
            el.addEventListener('mouseleave', () => {
              hidePreviewTimer = setTimeout(() => cursorPreview.classList.remove('visible'), 50);
            });
          });

          row.addEventListener('click', () => {
            lbItems = placementRows.map(r => ({ src: r.dataset.previewSrc, alt: r.dataset.previewTitle || '', caption: r.dataset.previewTitle || '' }));
            lbShowAt(i);
            lightbox.classList.add('open');
          });
        });
      }

      // Feature images in bottom frame — cursor label + lightbox
      const featureImgs = Array.from(document.querySelectorAll('.feature-img'));
      const featureImgLabel = document.getElementById('feature-img-cursor-label');

      if (featureImgLabel && window.matchMedia('(hover: hover)').matches) {
        featureImgs.forEach((img, i) => {
          const wrap = img.closest('.feature-img-wrap');
          wrap.addEventListener('mouseenter', () => {
            featureImgLabel.textContent = img.dataset.title || '';
            featureImgLabel.classList.add('visible');
          });
          wrap.addEventListener('mouseleave', () => {
            featureImgLabel.classList.remove('visible');
          });
        });

        document.addEventListener('mousemove', e => {
          if (!featureImgLabel.classList.contains('visible')) return;
          featureImgLabel.style.left = (e.clientX + 14) + 'px';
          featureImgLabel.style.top = (e.clientY + 14) + 'px';
        });
      }

      featureImgs.forEach((img) => {
        img.addEventListener('click', () => {
          const frame = img.closest('.img-frame');
          const frameImgs = frame ? Array.from(frame.querySelectorAll('.feature-img')) : [img];
          const idx = frameImgs.indexOf(img);
          lbItems = frameImgs.map(fi => ({ src: fi.src, alt: fi.alt, caption: fi.dataset.title || '' }));
          lbShowAt(idx);
          lightbox.classList.add('open');
        });
      });

      // Page fade-out on navigation
      document.querySelectorAll('a[href]').forEach(link => {
        const href = link.getAttribute('href');
        if (!href || href.startsWith('#') || href.startsWith('mailto:') || link.target === '_blank') return;
        link.addEventListener('click', e => {
          e.preventDefault();
          document.body.style.transition = 'opacity 0.2s ease';
          document.body.style.opacity = '0';
          setTimeout(() => { window.location.href = href; }, 210);
        });
      });
    </script>
  </body>
</html>

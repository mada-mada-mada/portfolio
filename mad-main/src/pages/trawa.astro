    <div id="lightbox">
      <button id="lightbox-close" aria-label="Close">&#x2715;</button>
      <button id="lightbox-prev" aria-label="Previous image">&#8249;</button>
      <img id="lightbox-img" src="" alt="" />
      <p id="lightbox-caption"></p>
      <button id="lightbox-next" aria-label="Next image">&#8250;</button>
    </div>

    <script>
      const lightbox = document.getElementById('lightbox');
      const lightboxImg = document.getElementById('lightbox-img');
      const lightboxCaption = document.getElementById('lightbox-caption');
      const lightboxClose = document.getElementById('lightbox-close');
      const lightboxPrev = document.getElementById('lightbox-prev');
      const lightboxNext = document.getElementById('lightbox-next');
      let lbItems = [];
      let lbIdx = 0;

      function lbShowAt(i) {
        lbIdx = (i + lbItems.length) % lbItems.length;
        const item = lbItems[lbIdx];
        lightboxImg.src = item.src;
        lightboxImg.alt = item.alt;
        lightboxCaption.textContent = item.caption;
        const multi = lbItems.length > 1;
        lightboxPrev.style.display = multi ? '' : 'none';
        lightboxNext.style.display = multi ? '' : 'none';
      }

      function lbOpen(clickedImg) {
        const frame = clickedImg.closest('.img-frame');
        const imgs = frame ? Array.from(frame.querySelectorAll('.wide-img')) : [clickedImg];
        lbItems = imgs.map(img => ({
          src: img.dataset.full || img.src,
          alt: img.alt,
          caption: img.dataset.caption || img.alt,
        }));
        lbShowAt(imgs.indexOf(clickedImg));
        lightbox.classList.add('open');
      }

      function lbClose() { lightbox.classList.remove('open'); }

      document.querySelectorAll('.wide-img').forEach(img => {
        img.addEventListener('click', () => lbOpen(img));
      });

      lightboxClose.addEventListener('click', lbClose);
      lightboxPrev.addEventListener('click', e => { e.stopPropagation(); lbShowAt(lbIdx - 1); });
      lightboxNext.addEventListener('click', e => { e.stopPropagation(); lbShowAt(lbIdx + 1); });
      lightbox.addEventListener('click', e => { if (e.target === lightbox) lbClose(); });
      document.addEventListener('keydown', e => {
        if (!lightbox.classList.contains('open')) return;
        if (e.key === 'Escape') lbClose();
        else if (e.key === 'ArrowRight') lbShowAt(lbIdx + 1);
        else if (e.key === 'ArrowLeft') lbShowAt(lbIdx - 1);
      });

      let lbSwipeX = 0;
      lightbox.addEventListener('touchstart', e => { lbSwipeX = e.touches[0].clientX; }, { passive: true });
      lightbox.addEventListener('touchend', e => {
        const dx = e.changedTouches[0].clientX - lbSwipeX;
        if (Math.abs(dx) > 50) lbShowAt(lbIdx + (dx < 0 ? 1 : -1));
      });

      // Page fade-out on navigation
      document.querySelectorAll('a[href]').forEach(link => {
        const href = link.getAttribute('href');
        if (!href || href.startsWith('#') || href.startsWith('mailto:') || link.target === '_blank') return;
        link.addEventListener('click', e => {
          e.preventDefault();
          document.body.style.transition = 'opacity 0.2s ease';
          document.body.style.opacity = '0';
          setTimeout(() => { window.location.href = href; }, 210);
        });
      });
    </script>

    <script>
      // Wall bottom sheet (mobile) / tooltip (desktop via CSS hover)
      const wallTerm = document.querySelector('.wall-term');
      const wallPopup = document.getElementById('wall-popup');
      const wallOverlay = document.getElementById('wall-popup-overlay');
      if (wallTerm && wallPopup && wallOverlay) {
        wallTerm.addEventListener('click', e => {
          e.stopPropagation();
          wallPopup.classList.add('open');
          wallOverlay.classList.add('open');
        });
        wallOverlay.addEventListener('click', () => {
          wallPopup.classList.remove('open');
          wallOverlay.classList.remove('open');
        });
      }

      // Generic glossary terms — bottom sheet on mobile
      const glossaryPopup = document.getElementById('glossary-popup');
      const glossaryOverlay = document.getElementById('glossary-popup-overlay');
      const glossaryLabel = document.getElementById('glossary-popup-label');
      const glossaryText = document.getElementById('glossary-popup-text');
      if (glossaryPopup && glossaryOverlay) {
        document.querySelectorAll('.glossary-term').forEach(term => {
          term.addEventListener('click', e => {
            e.stopPropagation();
            glossaryLabel.textContent = term.dataset.term;
            glossaryText.textContent = term.dataset.def;
            glossaryPopup.classList.add('open');
            glossaryOverlay.classList.add('open');
          });
        });
        glossaryOverlay.addEventListener('click', () => {
          glossaryPopup.classList.remove('open');
          glossaryOverlay.classList.remove('open');
        });
      }

      // Lightbox — grouped by frame, with swipe + keyboard + prev/next nav
      const lightbox = document.getElementById('lightbox');
      const lightboxImg = document.getElementById('lightbox-img');
      const lightboxCaption = document.getElementById('lightbox-caption');
      const lightboxClose = document.getElementById('lightbox-close');
      const lightboxPrev = document.getElementById('lightbox-prev');
      const lightboxNext = document.getElementById('lightbox-next');

      let lbItems = [];
      let lbIdx = 0;

      function lbShowAt(i) {
        lbIdx = (i + lbItems.length) % lbItems.length;
        const item = lbItems[lbIdx];
        lightboxImg.src = item.src;
        lightboxImg.alt = item.alt;
        lightboxCaption.textContent = item.caption;
        const multi = lbItems.length > 1;
        lightboxPrev.style.display = multi ? '' : 'none';
        lightboxNext.style.display = multi ? '' : 'none';
      }

      function lbOpen(clickedImg) {
        const frame = clickedImg.closest('.img-frame, .img-strip');
        const imgs = frame
          ? Array.from(frame.querySelectorAll('.wide-img, .phone-shot, .comparison-phone, .comparison-card, .hierarchy-img'))
          : [clickedImg];
        const captionEl = frame ? frame.querySelector('.img-caption') : null;
        const caption = captionEl ? captionEl.textContent.trim() : '';
        lbItems = imgs.map(img => ({ src: img.src, alt: img.alt, caption }));
        lbIdx = imgs.indexOf(clickedImg);
        lbShowAt(lbIdx);
        lightbox.classList.add('open');
      }

      function lbClose() { lightbox.classList.remove('open'); }

      document.querySelectorAll('.wide-img, .phone-shot, .comparison-phone, .comparison-card, .hierarchy-img').forEach(img => {
        img.addEventListener('click', () => lbOpen(img));
      });

      // Before/after slots — click opens all 6 images in lightbox
      const baSlots = Array.from(document.querySelectorAll('.ba-slot'));
      if (baSlots.length) {
        const baAllImgs = Array.from(document.querySelectorAll('.before-after .ba-img'));
        baSlots.forEach((slot, i) => {
          slot.style.cursor = 'pointer';
          slot.addEventListener('click', () => {
            lbItems = baAllImgs.map(img => ({ src: img.src, alt: img.alt, caption: '' }));
            lbShowAt(i * 2);
            lightbox.classList.add('open');
          });
        });
      }

      lightboxClose.addEventListener('click', lbClose);
      lightboxPrev.addEventListener('click', e => { e.stopPropagation(); lbShowAt(lbIdx - 1); });
      lightboxNext.addEventListener('click', e => { e.stopPropagation(); lbShowAt(lbIdx + 1); });
      lightbox.addEventListener('click', e => { if (e.target === lightbox) lbClose(); });

      // Keyboard navigation
      document.addEventListener('keydown', e => {
        if (!lightbox.classList.contains('open')) return;
        if (e.key === 'ArrowRight') lbShowAt(lbIdx + 1);
        else if (e.key === 'ArrowLeft') lbShowAt(lbIdx - 1);
        else if (e.key === 'Escape') lbClose();
      });

      // Touch swipe
      let lbSwipeX = 0;
      lightbox.addEventListener('touchstart', e => {
        lbSwipeX = e.touches[0].clientX;
      }, { passive: true });
      lightbox.addEventListener('touchend', e => {
        const dx = e.changedTouches[0].clientX - lbSwipeX;
        if (Math.abs(dx) > 50) lbShowAt(lbIdx + (dx < 0 ? 1 : -1));
      });

      // Page fade-out on navigation
      document.querySelectorAll('a[href]').forEach(link => {
        const href = link.getAttribute('href');
        if (!href || href.startsWith('#') || href.startsWith('mailto:') || link.target === '_blank') return;
        link.addEventListener('click', e => {
          e.preventDefault();
          document.body.style.transition = 'opacity 0.2s ease';
          document.body.style.opacity = '0';
          setTimeout(() => { window.location.href = href; }, 210);
        });
      });
    </script>
  </body>
</html>

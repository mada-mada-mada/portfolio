    <div id="cursor-pill"></div>
    <div id="lightbox" aria-hidden="true">
      <img id="lightbox-img" src="" alt="" />
      <p id="lightbox-caption"></p>
    </div>

    <script>
      // Cursor pill
      const pill = document.getElementById('cursor-pill');
      const labelledItems = document.querySelectorAll('[data-label]');

      labelledItems.forEach(el => {
        el.addEventListener('mouseenter', () => {
          pill.textContent = el.dataset.label;
          pill.classList.add('visible');
        });
        el.addEventListener('mouseleave', () => pill.classList.remove('visible'));
      });

      document.addEventListener('mousemove', e => {
        pill.style.left = e.clientX + 'px';
        pill.style.top = e.clientY + 'px';
      });

      // Mobile lightbox with swipe
      if (window.matchMedia('(hover: none)').matches) {
        const lightbox = document.getElementById('lightbox');
        const lightboxImg = document.getElementById('lightbox-img');
        const lightboxCaption = document.getElementById('lightbox-caption');
        const originals = Array.from(document.querySelectorAll('.strip-item[data-original]'));
        const items = originals.map(el => {
          const img = el.querySelector('img');
          return { src: img.src, alt: img.alt, caption: el.dataset.label || '' };
        });
        let idx = 0;
        let touchStartX = 0;
        let didSwipe = false;

        function showAt(i) {
          idx = (i + items.length) % items.length;
          lightboxImg.src = items[idx].src;
          lightboxImg.alt = items[idx].alt;
          lightboxCaption.textContent = items[idx].caption;
        }

        function open(i) {
          showAt(i);
          lightbox.classList.add('open');
          lightbox.setAttribute('aria-hidden', 'false');
          document.body.style.overflow = 'hidden';
        }

        function close() {
          lightbox.classList.remove('open');
          lightbox.setAttribute('aria-hidden', 'true');
          document.body.style.overflow = '';
        }

        lightbox.addEventListener('touchstart', e => { touchStartX = e.touches[0].clientX; didSwipe = false; }, { passive: true });
        lightbox.addEventListener('touchmove', e => { if (Math.abs(e.touches[0].clientX - touchStartX) > 10) didSwipe = true; }, { passive: true });
        lightbox.addEventListener('touchend', e => {
          const dx = e.changedTouches[0].clientX - touchStartX;
          if (Math.abs(dx) > 50) showAt(idx + (dx < 0 ? 1 : -1));
        }, { passive: true });
        lightbox.addEventListener('click', () => { if (!didSwipe) close(); });

        originals.forEach((el, i) => el.addEventListener('click', () => open(i)));
      }

      // Page fade-out on navigation
      document.querySelectorAll('a[href]').forEach(link => {
        const href = link.getAttribute('href');
        if (!href || href.startsWith('#') || href.startsWith('mailto:') || link.target === '_blank') return;
        link.addEventListener('click', e => {
          e.preventDefault();
          document.body.style.transition = 'opacity 0.2s ease';
          document.body.style.opacity = '0';
          setTimeout(() => { window.location.href = href; }, 210);
        });
      });
    </script>
  </body>
</html>

---
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/icon_magda.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Magdalena Szymaniec — Senior Product Designer & Art Director based in Berlin." />
    <title>Magdalena Szymaniec</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Lora:wght@600&family=DM+Sans:wght@400;600&family=Gentium+Plus:wght@700&display=swap" rel="stylesheet" />
    <style>
      *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      @keyframes page-fade-in {
        from { opacity: 0; }
        to   { opacity: 1; }
      }

      body {
        font-family: 'DM Sans', sans-serif;
        background-color: #f7f6fa;
        color: #302b36;
        min-height: 100vh;
        display: flex;
        justify-content: center;
        animation: page-fade-in 0.35s ease both;
      }

      /* ── Nav ── */
      nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 24px;
        background-color: #f7f6fa;
        position: sticky;
        top: 0;
        z-index: 50;
      }

      .nav-identity {
        display: none;
        align-items: center;
        gap: 10px;
        text-decoration: none;
        color: #302b36;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.3s ease;
      }

      .nav-identity.visible {
        opacity: 1;
        pointer-events: auto;
      }

      .nav-name {
        font-size: 0.875rem;
        font-weight: 600;
      }

      .nav-links {
        display: flex;
        align-items: center;
        gap: 4px;
      }

      .nav-link {
        font-size: 0.875rem;
        font-weight: 600;
        color: #827d87;
        text-decoration: none;
        padding: 5px 14px;
        border-radius: 999px;
        transition: color 0.2s ease, background-color 0.2s ease;
      }

      .nav-link:hover {
        color: #302b36;
      }

      .nav-link.active {
        background-color: #9b90cc;
        color: #ffffff;
      }

      .nav-link.active:hover {
        background-color: #8778bc;
      }

      a:not(.btn-cv):not(.btn-case-study):not(.nav-link):not(.nav-identity) {
        color: #302b36;
        text-decoration: underline;
        text-underline-offset: 3px;
        text-decoration-thickness: 1px;
        text-decoration-color: #c8c5d0;
        transition: color 0.15s ease, text-decoration-color 0.15s ease;
      }

      a:not(.btn-cv):not(.btn-case-study):not(.nav-link):not(.nav-identity):hover {
        color: #9b90cc;
        text-decoration-color: #9b90cc;
      }

      .page {
        width: 100%;
        display: flex;
        flex-direction: column;
        min-height: 100vh;
      }

      main {
        flex: 1;
        padding: 40px 24px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 16px;
      }

      .header {
        display: flex;
        align-items: center;
        gap: 12px;
      }

      .header img {
        width: 64px;
        height: 63px;
        flex-shrink: 0;
      }

      .header-text {
        display: flex;
        flex-direction: column;
        gap: 3px;
      }

      .name {
        font-family: 'Lora', serif;
        font-size: 1.25rem;
        font-weight: 600;
        color: #302b36;
        line-height: 1.2;
      }

      .job-title {
        font-size: 0.875rem;
        font-weight: 400;
        color: #827d87;
        line-height: 1.3;
      }

      h1 {
        font-family: 'Lora', serif;
        font-size: 1.75rem;
        font-weight: 600;
        color: #302b36;
        line-height: 1.35;
      }

      .intro {
        font-size: 0.9375rem;
        color: #302b36;
        line-height: 1.55;
      }

      .cta {
        padding: 8px 0;
      }

      .btn-cv {
        display: inline-block;
        background-color: #9b90cc;
        color: #ffffff;
        font-family: 'DM Sans', sans-serif;
        font-size: 0.9375rem;
        font-weight: 600;
        text-decoration: none;
        padding: 10px 20px;
        transition: background-color 0.15s ease;
      }

      .btn-cv:hover {
        background-color: #8778bc;
      }

      footer {
        background-color: #eae5fc;
        padding: 24px 24px 40px;
        display: flex;
        flex-direction: column;
        gap: 16px;
      }

      .links {
        display: flex;
        flex-direction: column;
        gap: 8px;
        list-style: none;
      }

      .links a {
        font-size: 0.9375rem;
        font-weight: 400;
      }

      .copyright {
        font-size: 0.8125rem;
        color: #827d87;
        line-height: 1.55;
      }

      .case-study {
        background-color: #f3f1fe;
        padding: 24px 24px 16px;
        display: flex;
        flex-direction: column;
        gap: 12px;
      }

      .cs-meta {
        display: flex;
        flex-direction: column;
        gap: 2px;
      }

      .cs-date {
        font-size: 0.8125rem;
        color: #827d87;
      }

      .cs-title {
        font-family: 'Gentium Plus', serif;
        font-size: 1.375rem;
        font-weight: 700;
        color: #302b36;
        line-height: 1.2;
      }

      .cs-description {
        font-size: 0.9375rem;
        color: #302b36;
        line-height: 1.55;
      }

      .cs-preview {
        background-color: #f7f6fa;
        width: 100%;
        padding: 24px;
        display: flex;
        flex-direction: row;
        gap: 12px;
        align-items: center;
        justify-content: center;
        overflow-x: auto;
        border: 1px solid #d8d2f0;
      }

      .cs-preview .cs-screen {
        height: 180px;
        width: auto;
        flex-shrink: 0;
        display: block;
        border-radius: 6px;

      }

      .screen-slot {
        display: grid;
        grid-template-rows: 180px;
        grid-template-columns: max-content;
        flex-shrink: 0;
        border-radius: 7px;
        background-color: #eae5fc;
        overflow: hidden;

      }

      .screen-slot img {
        grid-area: 1 / 1;
        height: 180px;
        width: auto;
        opacity: 0;
        transition: opacity 1.2s ease;
      }


      .screen-wrap {
        position: relative;
        flex-shrink: 0;
      }

      #cursor-pill {
        position: fixed;
        pointer-events: none;
        background-color: #302b36;
        color: #ffffff;
        font-family: 'DM Sans', sans-serif;
        font-size: 0.8125rem;
        font-weight: 600;
        padding: 6px 14px;
        border-radius: 999px;
        white-space: nowrap;
        opacity: 0;
        transition: opacity 0.15s ease;
        z-index: 100;
        transform: translate(14px, -50%);
      }

      #cursor-pill.visible {
        opacity: 1;
      }

      .cs-cta {
        padding: 4px 0 8px;
      }

      .btn-case-study {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background-color: #9b90cc;
        color: #ffffff;
        font-family: 'DM Sans', sans-serif;
        font-size: 0.9375rem;
        font-weight: 600;
        text-decoration: none;
        padding: 8px 16px;
        transition: background-color 0.15s ease;
      }

      .btn-case-study:hover {
        background-color: #8778bc;
      }

      .btn-case-study svg {
        flex-shrink: 0;
      }

      /* ── Premium section ── */
      .case-study.premium {
        background-color: #f7f6fa;
      }
      .case-study.premium .cs-preview {
        background-color: #f3f1fe;
        border-color: #d8d2f0;
        overflow: hidden;
        display: block;
        padding: 24px 0;
      }

      .prem-reel {
        display: flex;
        width: max-content;
        align-items: center;
        will-change: transform;
        animation: scroll-prem 40s linear infinite;
      }

      .prem-reel:hover {
        animation-play-state: paused;
      }

      @keyframes scroll-prem {
        from { transform: translateX(0); }
        to   { transform: translateX(-50%); }
      }

      .prem-item {
        flex-shrink: 0;
        margin-right: 12px;
      }

      .prem-item img {
        height: 180px;
        width: auto;
        display: block;

      }

      @media (min-width: 640px) {
        nav {
          padding: 16px clamp(48px, 8vw, 160px);
        }

        .nav-identity {
          display: flex;
        }

        .nav-identity img {
          width: 34px;
          height: 34px;
        }

        main {
          padding: 80px clamp(48px, 8vw, 160px);
          gap: 24px;
        }

        h1 {
          font-size: 3rem;
          max-width: 22ch;
          line-height: 1.15;
        }

        .name {
          font-size: 1.5rem;
        }

        .job-title {
          font-size: 1rem;
        }

        .intro {
          font-size: 1rem;
          max-width: 52ch;
        }

        footer {
          padding: 40px clamp(48px, 8vw, 160px) 56px;
        }

        .links {
          flex-direction: row;
          gap: 32px;
        }

        .case-study {
          padding: 40px clamp(48px, 8vw, 160px);
          gap: 20px;
        }

        .cs-title {
          font-size: 1.75rem;
        }

        .cs-description {
          font-size: 1rem;
          max-width: 60ch;
        }

        .cs-preview {
          gap: 48px;
          padding: 48px 40px;
        }

        .cs-preview .cs-screen {
          height: 420px;
        }

        .screen-slot {
          grid-template-rows: 420px;
          border-radius: 16px;
        }


        .screen-slot img {
          height: 420px;
        }

        .case-study.premium .cs-preview {
          padding: 48px 0;
        }

        .prem-item {
          margin-right: 20px;
        }

        .prem-item img {
          height: 300px;
        }
      }

      @media (hover: none) {
        #cursor-pill { display: none; }
        .screen-wrap[data-label] { cursor: pointer; }
        .prem-item { cursor: pointer; }
      }

      #lightbox {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.88);
        z-index: 200;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 20px;
        padding: 32px 24px;
      }

      #lightbox.open { display: flex; }

      #lightbox img {
        max-width: 100%;
        max-height: 72vh;
        object-fit: contain;
        border-radius: 16px;
      }

      #lightbox-caption {
        color: #ffffff;
        font-family: 'DM Sans', sans-serif;
        font-size: 0.9375rem;
        font-weight: 600;
        text-align: center;
      }
    </style>
  </head>
  <body>
    <div class="page">
      <nav>
        <a href="/" class="nav-identity">
          <img src="/icon_magda.svg" width="28" height="28" alt="" />
          <span class="nav-name">Magdalena Szymaniec</span>
        </a>
        <div class="nav-links">
          <a href="/" class="nav-link active">home</a>
          <a href="/about" class="nav-link">about</a>
        </div>
      </nav>
      <main>
        <div class="header">
          <img src="/icon_magda.svg" alt="" width="49" height="48" />
          <div class="header-text">
            <p class="name">Magdalena Szymaniec</p>
            <p class="job-title">Senior Product Designer · Art Direction</p>
          </div>
        </div>

        <h1>Hi, Magdalena here! I'm a creative human based in Berlin, Germany.</h1>

        <p class="intro">
          Welcome to my portfolio. It's currently a work in progress. Feel free to reach out at <a href="mailto:magda.szymaniec@gmail.com">magda.szymaniec@gmail.com</a>
        </p>

        <div class="cta">
          <a href="/CV_magdalena.pdf" class="btn-cv" target="_blank" rel="noopener noreferrer">Download My CV</a>
        </div>
      </main>

      <section class="case-study">
        <div class="cs-meta">
          <span class="cs-date">2024–2026</span>
          <h2 class="cs-title">Blindmate Onboarding</h2>
        </div>

        <p class="cs-description">Most dating apps onboard one type of user (you guessed it, the single). Blindmate is different because friends swipe for their singles as Matchmakers. (not to mention, you can do both — swipe for others and get matches at the same time…) That's three distinct user types, one front door, and a concept nobody's seen before. You can't use the app without your friends either, so the trust required to sign up is high.<br /><br />This is the story of rewiring a mental model for a dating app that flips the dating app script.</p>

        <div class="cs-cta">
          <a href="/blindmate-onboarding" class="btn-case-study">
            Read Case Study
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M16.01 11H4v2h12.01v3L20 12l-3.99-4z"/></svg>
          </a>
        </div>

        <div class="cs-preview">
          <div class="screen-wrap" data-label="The Welcome Screen AB test">
            <div class="screen-slot">
              <img src="/blindmate/welcome/en-safety-network.png" alt="Safety network welcome screen" />
              <img src="/blindmate/welcome/en-bm-shift.png" alt="Blindmate shift welcome screen" />
              <img src="/blindmate/welcome/en-mm-approach.png" alt="Matchmaker approach welcome screen" />
              <img src="/blindmate/welcome/en-no-ai.png" alt="No AI welcome screen" />
              <img src="/blindmate/welcome/en-testimonial.png" alt="Testimonial welcome screen" />
            </div>
          </div>
          <div class="screen-wrap" data-label="Finding out your role through a conversation">
            <img class="cs-screen" src="/blindmate/conversational-onboarding.png" alt="Conversational onboarding screen" />
          </div>
          <div class="screen-wrap" data-label="Friends are required to enter the Blindmate dimension">
            <img class="cs-screen" src="/blindmate/invites-sent.png" alt="Invites sent onboarding screen" />
          </div>
        </div>
      </section>

      <section class="case-study premium">
        <div class="cs-meta">
          <span class="cs-date">2025</span>
          <h2 class="cs-title">Blindmate Premium</h2>
        </div>

        <p class="cs-description">Blindmate is your friendly neighbourhood Spider-Man of dating apps — social, fair, on your side. So when it came time to build a monetization model, the rules were simple: don't hurt organic growth, don't break user trust.<br /><br />Two months, five features, a pricing model that trusts its users, and a conversion rate that beats Tinder. Not bad for the nice app.</p>

        <div class="cs-cta">
          <a href="/blindmate-premium" class="btn-case-study">
            Read Case Study
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M16.01 11H4v2h12.01v3L20 12l-3.99-4z"/></svg>
          </a>
        </div>

        <div class="cs-preview">
          <div class="prem-reel">
            <div class="prem-item" data-label="Likes"><img src="/premium/likes.svg" alt="Likes" /></div>
            <div class="prem-item" data-label="3x More Swipes"><img src="/premium/swipes.svg" alt="3x More Swipes" /></div>
            <div class="prem-item" data-label="Search Filters"><img src="/premium/search-filters.svg" alt="Search Filters" /></div>
            <div class="prem-item" data-label="Image Analysis"><img src="/premium/image.svg" alt="Image Analysis" /></div>
            <div class="prem-item" data-label="Compatibility"><img src="/premium/compatibility.svg" alt="Compatibility" /></div>
            <!-- duplicated for seamless loop -->
            <div class="prem-item" aria-hidden="true"><img src="/premium/likes.svg" alt="" /></div>
            <div class="prem-item" aria-hidden="true"><img src="/premium/swipes.svg" alt="" /></div>
            <div class="prem-item" aria-hidden="true"><img src="/premium/search-filters.svg" alt="" /></div>
            <div class="prem-item" aria-hidden="true"><img src="/premium/image.svg" alt="" /></div>
            <div class="prem-item" aria-hidden="true"><img src="/premium/compatibility.svg" alt="" /></div>
          </div>
        </div>
      </section>

      <footer>
        <ul class="links">
          <li><a href="https://linkedin.com/in/magdalena-szymaniec-6a697246" target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
          <li><a href="https://magdalenadraws.com/" target="_blank" rel="noopener noreferrer">Illustration Portfolio</a></li>
          <li><a href="https://www.instagram.com/magdalenadraws/" target="_blank" rel="noopener noreferrer">Instagram</a></li>
        </ul>
        <p class="copyright">All works © Magdalena Szymaniec, 2026. This website was designed and vibe-coded by yours truly. Please do not reproduce without the expressed written consent of the author.</p>
      </footer>
    </div>
    <div id="cursor-pill"></div>
    <div id="lightbox" aria-hidden="true">
      <img id="lightbox-img" src="" alt="" />
      <p id="lightbox-caption"></p>
    </div>

    <script>
      // Nav identity — hide while h1 is visible, show after scroll
      const navIdentity = document.querySelector('.nav-identity');
      const heroH1 = document.querySelector('h1');
      new IntersectionObserver(([entry]) => {
        navIdentity.classList.toggle('visible', !entry.isIntersecting);
      }, { threshold: 0 }).observe(heroH1);

      // Crossfade animation
      const imgs = Array.from(document.querySelectorAll('.screen-slot img'));
      let idx = 0;

      function next() {
        imgs[idx].style.opacity = '0';
        idx = (idx + 1) % imgs.length;
        imgs[idx].style.opacity = '1';
        setTimeout(next, 5000);
      }

      imgs[0].style.opacity = '1';
      setTimeout(next, 5000);

      // Cursor pill
      const pill = document.getElementById('cursor-pill');
      const wraps = document.querySelectorAll('.screen-wrap[data-label]');

      wraps.forEach(wrap => {
        wrap.addEventListener('mouseenter', () => {
          pill.textContent = wrap.dataset.label;
          pill.classList.add('visible');
        });
        wrap.addEventListener('mouseleave', () => {
          pill.classList.remove('visible');
        });
      });

      document.addEventListener('mousemove', e => {
        pill.style.left = e.clientX + 'px';
        pill.style.top = e.clientY + 'px';
      });

      // Mobile lightbox
      if (window.matchMedia('(hover: none)').matches) {
        const lightbox = document.getElementById('lightbox');
        const lightboxImg = document.getElementById('lightbox-img');
        const lightboxCaption = document.getElementById('lightbox-caption');
        let lightboxItems = [];
        let lightboxIdx = 0;
        let touchStartX = 0;
        let didSwipe = false;

        function getWrapImage(wrap) {
          const slot = wrap.querySelector('.screen-slot');
          if (slot) return Array.from(slot.querySelectorAll('img')).find(img => img.style.opacity === '1') || slot.querySelector('img');
          return wrap.querySelector('img');
        }

        function showAt(i) {
          lightboxIdx = (i + lightboxItems.length) % lightboxItems.length;
          const item = lightboxItems[lightboxIdx];
          lightboxImg.src = item.src;
          lightboxImg.alt = item.alt || '';
          lightboxCaption.textContent = item.caption;
        }

        function openLightbox(startIdx) {
          lightboxItems = Array.from(wraps).map(wrap => {
            const img = getWrapImage(wrap);
            return { src: img.src, alt: img.alt, caption: wrap.dataset.label };
          });
          showAt(startIdx);
          lightbox.classList.add('open');
          lightbox.setAttribute('aria-hidden', 'false');
          document.body.style.overflow = 'hidden';
        }

        function closeLightbox() {
          lightbox.classList.remove('open');
          lightbox.setAttribute('aria-hidden', 'true');
          document.body.style.overflow = '';
        }

        lightbox.addEventListener('touchstart', e => {
          touchStartX = e.touches[0].clientX;
          didSwipe = false;
        }, { passive: true });

        lightbox.addEventListener('touchmove', e => {
          if (Math.abs(e.touches[0].clientX - touchStartX) > 10) didSwipe = true;
        }, { passive: true });

        lightbox.addEventListener('touchend', e => {
          const dx = e.changedTouches[0].clientX - touchStartX;
          if (Math.abs(dx) > 50) showAt(lightboxIdx + (dx < 0 ? 1 : -1));
        }, { passive: true });

        lightbox.addEventListener('click', () => { if (!didSwipe) closeLightbox(); });

        wraps.forEach((wrap, i) => {
          wrap.addEventListener('click', () => openLightbox(i));
        });

        // Premium carousel lightbox
        const premOriginals = Array.from(document.querySelectorAll('.prem-item[data-label]'));
        const premLbItems = premOriginals.map(el => {
          const img = el.querySelector('img');
          return { src: img.src, alt: img.alt, caption: el.dataset.label };
        });

        // Attach to all items (originals + duplicates) — duplicates map back via mod 5
        Array.from(document.querySelectorAll('.prem-item')).forEach((el, i) => {
          el.addEventListener('click', () => {
            lightboxItems = premLbItems;
            showAt(i % premLbItems.length);
            lightbox.classList.add('open');
            lightbox.setAttribute('aria-hidden', 'false');
            document.body.style.overflow = 'hidden';
          });
        });
      }

      // Page fade-out on navigation
      document.querySelectorAll('a[href]').forEach(link => {
        const href = link.getAttribute('href');
        if (!href || href.startsWith('#') || href.startsWith('mailto:') || link.target === '_blank') return;
        link.addEventListener('click', e => {
          e.preventDefault();
          document.body.style.transition = 'opacity 0.2s ease';
          document.body.style.opacity = '0';
          setTimeout(() => { window.location.href = href; }, 210);
        });
      });
    </script>
  </body>
</html>
